/*
 * secrets.h.example
 * ------------------
 * Template for private credentials used by LandslideDetection.ino.
 *
 * HOW TO USE:
 *   1. Copy this file and rename the copy to "secrets.h" (same folder).
 *   2. Fill in your real Wi-Fi, Blynk, and ThingSpeak values below.
 *   3. Never commit "secrets.h" — it is already listed in .gitignore.
 *
 * Get your own values from:
 *   - Blynk template ID / name / auth token: https://blynk.cloud  (My Templates)
 *   - ThingSpeak channel ID / Write API Key: https://thingspeak.com (My Channels)
 */

#ifndef SECRETS_H
#define SECRETS_H

// ---- Blynk ----
#define BLYNK_TEMPLATE_ID   "YOUR_BLYNK_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_BLYNK_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"

// ---- Wi-Fi ----
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ---- ThingSpeak ----
#define THINGSPEAK_CHANNEL_ID 0000000UL
#define THINGSPEAK_API_KEY    "YOUR_THINGSPEAK_WRITE_API_KEY"

#endif // SECRETS_H
