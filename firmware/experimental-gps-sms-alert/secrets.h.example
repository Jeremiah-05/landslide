 * Never commit "secrets.h" — it is already listed in .gitignore.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ---- Blynk ----
#define BLYNK_TEMPLATE_ID   "YOUR_BLYNK_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_BLYNK_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"

// ---- Wi-Fi ----
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ---- ThingSpeak ----
#define THINGSPEAK_CHANNEL_ID 0000000UL
#define THINGSPEAK_API_KEY    "YOUR_THINGSPEAK_WRITE_API_KEY"

// ---- SMS alert recipient (GSM module) ----
#define ALERT_PHONE_NUMBER "+10000000000"

#endif // SECRETS_H
